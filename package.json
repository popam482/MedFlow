{
  "name": "medflow",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "externals:sync": "git submodule sync --recursive && git submodule update --init --recursive",
    "externals:plan": "node --experimental-strip-types scripts/externals.ts plan",
    "externals:install": "node --experimental-strip-types scripts/externals.ts install",
    "build": "node --experimental-strip-types scripts/externals.ts build",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test scripts/externals.test.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "yaml": "^2.9.1"
  }
}
